# Copy this file to ".env" (which is git-ignored) and edit. Never commit real keys.

# --- Which LLM answers questions: ollama | bedrock | fake ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=120

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434


# If a teammate hosts the strong model for the demo, point at their machine:
# OLLAMA_BASE_URL=http://192.168.1.50:11434

# --- AWS Bedrock (demo option) ---
# LLM_PROVIDER=bedrock
# LLM_MODEL=anthropic.claude-3-5-haiku-20241022-v1:0
# AWS_REGION=us-east-1
# Credentials: use `aws configure` / SSO, or AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY here.

# --- Frontend origins allowed to call the API (JSON list) ---
# CORS_ORIGINS=["http://localhost:4200"]