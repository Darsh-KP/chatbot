# Copy this file to ".env" (which is git-ignored) and edit. Never commit real keys.

# --- Which LLM answers questions: ollama | fake ---
# "fake" returns a canned reply, so the API and UI can be built without Ollama running.
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=120

# --- Ollama (used for chat AND embeddings) ---
OLLAMA_BASE_URL=http://localhost:11434
# If a teammate hosts the model for the demo, point at their machine:
# OLLAMA_BASE_URL=http://192.168.1.50:11434

# --- Retrieval (optional; defaults are in src/config.py) ---
# RAG_COLLECTION=spring_docs
# RAG_TOP_K=4
# RAG_MAX_DISTANCE is off by default; set a number only after tuning it